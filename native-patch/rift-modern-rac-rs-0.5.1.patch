diff --git "a/rac-rs/src/rac1/retail/modcam.rs" "b/rac-rs/src/rac1/retail/modcam.rs"
index d5f2d8c..a192c4b 100644
--- "a/rac-rs/src/rac1/retail/modcam.rs"
+++ "b/rac-rs/src/rac1/retail/modcam.rs"
@@ -115,9 +115,61 @@ pub fn ui_aim(down: bool) {
 /// Gamepad R2 held (prompts.rs `poll_pad`): aim mode like RMB.
 static PAD_AIM: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
 
-/// R2 down / up on the gamepad.
-pub fn pad_aim(down: bool) {
-	PAD_AIM.store(down, std::sync::atomic::Ordering::Relaxed);
+/// Double-tap state for the controller's already-remapped Aim action.
+#[derive(Default)]
+struct PadAimTap {
+	tick: u32,
+	press_at: Option<u32>,
+	first_tap: Option<u32>,
+	second_tap: bool,
+	previous: bool,
+	latched: bool,
+}
+static PAD_AIM_TAP: Mutex<PadAimTap> = Mutex::new(PadAimTap { tick: 0, press_at: None, first_tap: None, second_tap: false, previous: false, latched: false });
+
+/// Gamepad Aim down / up after RAC-RS has applied the user's button remap.
+/// Two taps (each <=250 ms, within 380 ms) toggle persistent Aim; a normal hold still aims while held.
+pub fn pad_aim(down: bool, gameplay: bool) {
+	let mut effective = down;
+	if let Ok(mut s) = PAD_AIM_TAP.lock() {
+		if !gameplay {
+			*s = PadAimTap::default();
+			PAD_AIM.store(false, std::sync::atomic::Ordering::Relaxed);
+			return;
+		}
+		s.tick = s.tick.wrapping_add(1);
+		let tick = s.tick;
+		if !down {
+			if s.previous {
+				let short = s.press_at.is_some_and(|t| tick.wrapping_sub(t) <= 13);
+				if short && s.second_tap {
+					s.latched = !s.latched;
+					s.first_tap = None;
+					eprintln!("controller Aim double-tap: latched={}", s.latched);
+				} else if short {
+					s.first_tap = Some(tick);
+				} else {
+					s.first_tap = None;
+				}
+				s.press_at = None;
+				s.second_tap = false;
+			}
+			s.previous = false;
+			effective = s.latched;
+		} else {
+			if !s.previous {
+				if s.first_tap.is_some_and(|t| tick.wrapping_sub(t) <= 19) {
+					s.second_tap = true;
+				} else {
+					s.first_tap = None;
+					s.second_tap = false;
+				}
+				s.press_at = Some(tick);
+			}
+			s.previous = true;
+		}
+	}
+	PAD_AIM.store(effective, std::sync::atomic::Ordering::Relaxed);
 }
 
