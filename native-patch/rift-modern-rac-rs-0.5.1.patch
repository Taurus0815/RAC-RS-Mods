+//! Optional Rift Modern weapon pictures and wheel panels, loaded with HUD art.
+use super::*;
+
+pub(super) fn load(tex: &mut Vec<Texture>, art: &mut HudArt) {
+	let Some(root) = crate::texpack::mods::mods_root() else { return };
+	let active = std::fs::read_to_string(root.join("active.txt")).unwrap_or_default();
+	if !active.lines().any(|line| line.split('#').next().unwrap_or("").trim() == "rift-modern") {
+		return;
+	}
+	let folder = root.join("rift-modern").join("images");
+	for def in crate::omni::draw_art::defs().iter().filter(|def| matches!(def.src, crate::omni::draw_art::Src::Rift)) {
+		let file = if let Some(id) = def.name.strip_prefix("rift.item.") {
+			format!("item-{id}.png")
+		} else if def.name == "rift.wheel.base" {
+			"wheel-base.png".into()
+		} else if let Some(i) = def.name.strip_prefix("rift.wheel.focus.") {
+			format!("wheel-focus-{i}.png")
+		} else {
+			continue;
+		};
+		let Ok(bytes) = std::fs::read(folder.join(&file)) else { continue };
+		if bytes.len() > 8 * 1024 * 1024 { continue; }
+		let image = match crate::texpack::png::load(&bytes) {
+			Ok(image) if image.w <= 2048 && image.h <= 2048 => image,
+			Ok(_) => continue,
+			Err(err) => { eprintln!("rift art: {file}: {err}"); continue; }
+		};
+		let rgba = image.levels[0].chunks_exact(4).map(|p| [p[0], p[1], p[2], p[3]]).collect();
+		art.rift.insert(def.name.clone(), (1 + tex.len(), image.w as f32, image.h as f32));
+		tex.push(Texture { w: image.w as usize, h: image.h as usize, rgba });
+	}
+	eprintln!("rift art: {} high-resolution pictures and wheel panels loaded", art.rift.len());
+}

