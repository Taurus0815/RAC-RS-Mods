+//! Mod-owned presentation switch. No menu state, bindings or saves are modified.
+use std::sync::atomic::{AtomicBool, Ordering};
+static ON: AtomicBool = AtomicBool::new(false);
+pub fn on() -> bool { ON.load(Ordering::Relaxed) }
+pub fn sync(c: &mut ee_oracle::cpu::Cpu) {
+    ON.store(c.mem.rd32(super::pcext::BASE) == 0x3158_4350 && c.mem.rd8(super::pcext::BASE + 0x41) == 1, Ordering::Relaxed);
+}
+/// Colour roles used by the front-end mirror; original colours survive the U toggle.
+pub fn colour(c: [f32; 4]) -> [f32; 4] {
+    if !on() { return c; }
+    let [r,g,b,a]=c;
+    let rgb = if r > 0.7 && g > 0.65 && b < g * 0.8 { [0.298,0.906,1.0] }
+    else if r > b * 1.1 && g > b * 1.05 && r > 0.15 { [0.16,0.48,0.61] }
+    else if b > r * 1.2 && b > g * 1.1 { [0.59,0.68,0.75] }
+    else { [r,g,b] };
+    [rgb[0],rgb[1],rgb[2],a]
+}
+/// Native text/selection vertex colours (GS scale, alpha unchanged).
+pub fn vertex(c: [u8;4]) -> [u8;4] {
+    let [r,g,b,a]=c;
+    if r >= 100 && g >= 90 && u16::from(b)*5 < u16::from(g)*4 {
+        [76,231,255,a]
+    } else if u16::from(b)*4 > u16::from(r)*5 && b > g && b >= 60 {
+        [150,174,192,a]
+    } else { c }
+}
