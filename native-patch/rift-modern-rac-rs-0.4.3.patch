+//! Semantic skin of native menu art, before either the CPU or the sharp GPU raster.
+//! Only known menu FX geometry and font sheets are changed. Item pictures, previews,
+//! frozen world uploads, menu state and hit boxes keep their original data.
+use super::*;
+impl Gs {
+    pub(super) fn rift_skin(&mut self, st: &St, ty: u32, vs: &[Vtx]) -> bool {
+        if !crate::retail::rift_ui::on() || vs.is_empty() { return false; }
+        let textured=st.at & 0x10 != 0;
+        let (tw,th)=(1u32 << ((st.tex0>>26)&15).min(10),1u32 << ((st.tex0>>30)&15).min(10));
+        let psm=(st.tex0>>20)&63;
+        let n=if ty==6 {2} else {vs.len().min(3)};
+        let mut uv=[f32::MAX,f32::MIN,f32::MAX,f32::MIN];
+        for v in &vs[..n] {
+            let (u,t)=if st.at&0x100!=0 {(v.u as f32/16.0,v.v as f32/16.0)} else {
+                let q=if v.q==0.0 {1.0} else {v.q}; (v.s/q*tw as f32,v.t/q*th as f32)
+            };
+            uv[0]=uv[0].min(u);uv[1]=uv[1].max(u);uv[2]=uv[2].min(t);uv[3]=uv[3].max(t);
+        }
+        let (du,dv)=(uv[1]-uv[0],uv[3]-uv[2]);
+        // Title/pause atlas FX: tiled scanlines and random noise. Never icon-sized samples.
+        if textured && matches!((tw,th),(16,16)|(32,32)) && (du>tw as f32+2.0 || dv>th as f32+2.0) {
+            return true;
+        }
+        let (w,h)=(vs[..n].iter().map(|v|v.x).max().unwrap()-vs[..n].iter().map(|v|v.x).min().unwrap(),
+            vs[..n].iter().map(|v|v.y).max().unwrap()-vs[..n].iter().map(|v|v.y).min().unwrap());
+        let frame=textured && st.ov && tw==64 && th==64 && du>=60.0 && du<=64.5 && dv>=60.0 && dv<=64.5
+            && (w>70*16 || h>70*16);
+        if frame && ty==6 && vs[0].x<vs[1].x && vs[0].y<vs[1].y {
+            let mut flat=*st;
+            flat.at &= !0x10;
+            flat.alpha=0x44; // (Cs-Cd)*As+Cd: opaque panels, independent of the retail additive FX pass.
+            let mut a=vs[0]; let mut b=vs[1];
+            // The retail bevel is drawn AFTER labels. Its centre is transparent:
+            // never replace it (or the vignette underlay) with an opaque fill.
+            {
+                let (x0,y0,x1,y1)=(a.x,a.y,b.x,b.y);
+                for (x,y,xx,yy,col) in [
+                    (x0,y0,x0.saturating_add(24).min(x1),y1,[76,231,255,128]),
+                    (x0,y0,x1,y0.saturating_add(12).min(y1),[46,94,118,128]),
+                    (x0,y1.saturating_sub(12).max(y0),x1,y1,[188,140,255,128]),
+                ] {
+                    a.x=x;a.y=y;b.x=xx;b.y=yy;a.rgba=col;b.rgba=col;
+                    self.raster_original(&flat,6,&[a,b]);
+                }
+            }
+            return true;
+        }
+        // Text is rendered into 512x128 menu plates as well as directly to screen.
+        // Restrict colour conversion to font sheets and flat selection geometry.
+        if frame || !textured || (tw==256 && th==128 && matches!(psm,0x13|0x14)) {
+            let mut changed=false;
+            let v:Vec<_>=vs.iter().map(|v| {
+                let colour=if frame {[76,231,255,v.rgba[3]]} else {crate::retail::rift_ui::vertex(v.rgba)};
+                changed |= colour!=v.rgba;
+                Vtx { rgba:colour,..*v }
+            }).collect();
+            if changed { self.raster_original(st,ty,&v); return true; }
+        }
+        false
+    }
+}
